[Unit]
Description=Orphic Keys USB MIDI Instrument
After=sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ivorybox
SupplementaryGroups=audio
WorkingDirectory=/opt/ivorybox
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/ivorybox/config
ExecStart=/usr/bin/python3 -m ivorybox --device ${AUDIO_DEVICE} --soundfont ${SOUNDFONT} --gain ${GAIN} --period ${PERIOD} --midi-match ${MIDI_MATCH}
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
